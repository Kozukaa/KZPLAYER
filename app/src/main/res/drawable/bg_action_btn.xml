<?xml version="1.0" encoding="utf-8"?>
<!-- v359 : bouton d action compact. Au focus : fond accent + gros contour clair,
     donc impossible de ne pas voir ou on se trouve sur une TV. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzAccent" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="@color/text" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzAccent" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="@color/text" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzCard" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="?attr/kzStroke" />
        </shape>
    </item>
</selector>
