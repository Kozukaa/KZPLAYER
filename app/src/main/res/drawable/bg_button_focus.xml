<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focus subtil : rouge leger + fine bordure, pas de gros cadre agressif -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="22dp" />
            <stroke android:width="2dp" android:color="@color/danger" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger" />
            <corners android:radius="22dp" />
            <stroke android:width="2dp" android:color="@color/text" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent2" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
</selector>
