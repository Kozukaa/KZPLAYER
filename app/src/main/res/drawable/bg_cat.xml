<?xml version="1.0" encoding="utf-8"?>
<!-- Chips de categories : relief via degrade + transparence + lisere. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Categorie ciblee a la telecommande : voile accent vitre + bordure accent -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccentSoft"
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="?attr/kzAccent" />
        </shape>
    </item>
    <!-- Categorie active : degrade accent -> accent fonce + fin lisere clair -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccent"
                android:endColor="?attr/kzAccent2"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccent2"
                android:endColor="?attr/kzAccent"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <!-- Etat normal : verre subtil (transparent) + lisere discret -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1AFFFFFF"
                android:endColor="#05FFFFFF"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="?attr/kzStroke" />
        </shape>
    </item>
</selector>
