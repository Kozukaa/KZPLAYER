<?xml version="1.0" encoding="utf-8"?>
<!-- Puce Favori. Curseur (focus telecommande) = rouge plein bien visible,
     coherent avec le bouton Lecture, pour toujours voir ou on est. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzAccent" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="?attr/kzAccent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzAccent" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/text" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzAccent" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="?attr/kzAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181A1F" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#3A3D44" />
        </shape>
    </item>
</selector>
