<?xml version="1.0" encoding="utf-8"?>
<!-- Carte poster : coins 14dp, stroke discret par defaut, ring accent + halo blanc au focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/kzAccent" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/kzCard" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#EEFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzCard" />
            <stroke android:width="2dp" android:color="?attr/kzAccent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzCard" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
