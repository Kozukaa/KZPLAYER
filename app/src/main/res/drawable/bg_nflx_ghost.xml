<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton "ghost" pill : verre semi-transparent par defaut, accent plein au focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzAccent" />
            <corners android:radius="100dp" />
            <stroke android:width="2dp" android:color="#EEFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzAccent" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</selector>
