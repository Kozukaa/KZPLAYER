<?xml version="1.0" encoding="utf-8"?>
<!-- Fond hero cinematique : degrade radial sombre + touche d'accent (chaleur). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#FF15161C"
                android:centerColor="#FF0C0D12"
                android:endColor="#FF050609" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="520"
                android:centerX="0.15"
                android:centerY="0.35"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
