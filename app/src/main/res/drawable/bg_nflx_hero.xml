<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de la banniere Netflix : noir profond + halo rouge signature en haut,
     et voile sombre en bas pour la lisibilite du texte. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#050506"
                android:centerColor="#0A0A0C"
                android:endColor="#160E10" />
        </shape>
    </item>
    <item android:left="-140dp" android:top="-190dp" android:right="200dp" android:bottom="120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="380dp"
                android:startColor="#66E50914"
                android:centerColor="#22E50914"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#F2000000"
                android:centerColor="#40000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
