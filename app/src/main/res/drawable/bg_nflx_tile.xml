<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile "Parcourir" : degrade sombre elegant, coins 16dp, focus = accent glow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="?attr/kzAccent"
                android:centerColor="?attr/kzAccent2"
                android:endColor="#FF14151B" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#EEFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="?attr/kzAccent"
                android:centerColor="?attr/kzAccent2"
                android:endColor="#FF14151B" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#EEFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF1D1E26"
                android:centerColor="#FF14151B"
                android:endColor="#FF0C0D12" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
