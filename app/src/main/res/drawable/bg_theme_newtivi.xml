<?xml version="1.0" encoding="utf-8"?>
<!-- Carte theme NewTivi : degrade base sur l'accent utilisateur (change avec la
     couleur choisie dans Parametres > Couleur). Meme forme et couleur que les 2
     autres cartes ; seul le titre / icone / badge diffèrent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccent"
                android:centerColor="?attr/kzAccent2"
                android:endColor="#FF1A1A22"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#EEFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccent"
                android:centerColor="?attr/kzAccent2"
                android:endColor="#FF1A1A22"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#EEFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccent"
                android:centerColor="?attr/kzAccent2"
                android:endColor="#FF1A1A22"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
