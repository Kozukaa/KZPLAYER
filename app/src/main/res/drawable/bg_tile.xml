<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Element selectionne a la telecommande (focus D-pad) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzCard" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="?attr/kzAccent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzCard" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="?attr/kzAccent" />
        </shape>
    </item>
    <!-- Etat normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzCard" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="?attr/kzStroke" />
        </shape>
    </item>
</selector>
