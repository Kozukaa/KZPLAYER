<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Element cible (focus D-pad) : degrade carte + bordure accent -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzCard"
                android:endColor="?attr/kzBg2"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="?attr/kzAccent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzCard"
                android:endColor="?attr/kzBg2"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="?attr/kzAccent" />
        </shape>
    </item>
    <!-- Etat normal : degrade carte subtil + fin lisere -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzCard"
                android:endColor="?attr/kzBg2"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="?attr/kzStroke" />
        </shape>
    </item>
</selector>
