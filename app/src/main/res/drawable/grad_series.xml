<?xml version="1.0" encoding="utf-8"?>
<!-- Degrade pilote par le theme : accent -> accent2 -> fond neutre. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccent"
                android:centerColor="?attr/kzAccent2"
                android:endColor="@color/grad_dark"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#99FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccent"
                android:centerColor="?attr/kzAccent2"
                android:endColor="@color/grad_dark"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#99FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/kzAccent"
                android:centerColor="?attr/kzAccent2"
                android:endColor="@color/grad_dark"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
