<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D43A44"
                android:centerColor="#8E0913"
                android:endColor="#220307"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="2dp" android:color="#E06B73" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D43A44"
                android:centerColor="#8E0913"
                android:endColor="#220307"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="2dp" android:color="#E06B73" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#B0060F"
                android:centerColor="#6E040A"
                android:endColor="#180204"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
