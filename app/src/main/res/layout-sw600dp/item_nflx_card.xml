<?xml version="1.0" encoding="utf-8"?>
<!-- Carte poster Netflix : image + scrim bas + titre en overlay + sous-titre.
     Le fond bg_nflx_card gere le focus (ring blanc + halo accent). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="152dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_nflx_card"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="206dp">

            <ImageView
                android:id="@+id/posterIv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tile"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!-- Scrim degrade pour lisibilite du titre en overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_nflx_poster_scrim" />

            <!-- Petit badge HD en haut a droite -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_nflx_pill"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="HD"
                android:textColor="#FFFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nameTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </FrameLayout>

        <TextView
            android:id="@+id/subTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
