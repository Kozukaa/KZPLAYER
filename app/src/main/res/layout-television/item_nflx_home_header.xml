<?xml version="1.0" encoding="utf-8"?>
<!-- HOME NETFLIX - Header ultra premium :
     - Hero cinematique degrade sombre (bg_nflx_hero) avec vignette radiale
     - Poster flottant a droite (heroImg) : rendu net, arrondis 18dp, ombre
     - Bloc titre a gauche : brand + BIG title + chips meta + description + boutons pill
     - Rangee "Parcourir" refaite : tuiles avec icone dans rond degrade + focus glow
     Tous les IDs existants sont conserves pour ne pas casser NetflixHomeActivity.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false">

    <!-- ============================ HERO ============================ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="@drawable/bg_nflx_hero"
        android:clipChildren="false">

        <!-- Poster flottant : occupe le tiers droit. On garde l'ID heroImg attendu par le Kotlin. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/heroPosterCard"
            android:layout_width="260dp"
            android:layout_height="330dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="48dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="14dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <ImageView
                android:id="@+id/heroImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nflx_hero"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter" />
        </androidx.cardview.widget.CardView>

        <!-- Scrim gauche->droite pour la lisibilite du texte. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nflx_hero_scrim_left" />

        <!-- Scrim bas pour fondre le hero avec la rangee "Parcourir". -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim_bottom" />

        <!-- Logo KZ en haut a gauche. -->
        <ImageView
            android:layout_width="170dp"
            android:layout_height="50dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="40dp"
            android:layout_marginTop="22dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitStart"
            android:src="@drawable/kz_logo_wide" />

        <!-- Bloc gauche : brand + titre + meta chips + description + boutons -->
        <LinearLayout
            android:layout_width="620dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/heroBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:text="KZ PLAYER  \u2022  TON UNIVERS"
                android:textColor="?attr/kzAccent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Ton univers TV, Films et S\u00e9ries"
                android:textColor="@color/text"
                android:textSize="36sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:lineSpacingExtra="-2dp" />

            <!-- Chips meta : HD / DIRECT / DUREE / etc. -->
            <LinearLayout
                android:id="@+id/heroBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_nflx_pill_accent"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="EN VEDETTE"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_nflx_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="HD"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_nflx_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="\u2605 4.8"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_nflx_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="CINEMA \u2022 TV \u2022 S\u00c9RIES"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Choisis une section pour commencer, ou reprends ta derniere lecture en un clic."
                android:textColor="#EEFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <!-- Boutons hero : Play + Films + Series -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/heroPlayTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_nflx_play"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="28dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="14dp"
                    android:text="\u25B6   REGARDER LA TV"
                    android:textColor="#FF000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/heroMovies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_nflx_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="22dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="14dp"
                    android:text="\uD83C\uDFAC  FILMS"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/heroSeries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_nflx_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="22dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="14dp"
                    android:text="\uD83D\uDCFA  S\u00c9RIES"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ==================== RANGEE "PARCOURIR" ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="40dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp">
        <View
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:background="?attr/kzAccent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Parcourir"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal">

            <!-- TILE : TV en direct -->
            <LinearLayout
                android:id="@+id/tileTv"
                android:layout_width="156dp"
                android:layout_height="120dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_nflx_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nflx_tile_icon">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_live_tv"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="TV en direct"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TILE : Films -->
            <LinearLayout
                android:id="@+id/tileMovies"
                android:layout_width="156dp"
                android:layout_height="120dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_nflx_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nflx_tile_icon">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_movie"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Films"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TILE : Series -->
            <LinearLayout
                android:id="@+id/tileSeries"
                android:layout_width="156dp"
                android:layout_height="120dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_nflx_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nflx_tile_icon">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_series"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="S\u00e9ries"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TILE : Guide TV -->
            <LinearLayout
                android:id="@+id/tileGuide"
                android:layout_width="156dp"
                android:layout_height="120dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_nflx_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nflx_tile_icon">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_epg"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Guide TV"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TILE : Listes -->
            <LinearLayout
                android:id="@+id/tilePlaylist"
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_nflx_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_nflx_tile_icon">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_person" android:tint="#FFFFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Listes" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- TILE : Recherche vocale -->
            <LinearLayout
                android:id="@+id/tileVoice"
                android:layout_width="156dp"
                android:layout_height="120dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_nflx_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nflx_tile_icon">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mic"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Recherche vocale"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TILE : Parametres -->
            <LinearLayout
                android:id="@+id/tileSettings"
                android:layout_width="156dp"
                android:layout_height="120dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_nflx_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nflx_tile_icon">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Param\u00e8tres"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TILE : Theme -->
            <LinearLayout
                android:id="@+id/tileTheme"
                android:layout_width="156dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_nflx_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nflx_tile_icon">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Th\u00e8me"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
