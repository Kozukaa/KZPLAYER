<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="11dp"
    android:padding="5dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_tile">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp">
        <ImageView
            android:id="@+id/epThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="?attr/kzBg2"
            android:src="@drawable/ic_movie"
            android:contentDescription="@null" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim_bottom" />
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:text="\u25B6"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:background="@drawable/bg_now_badge" />
    </FrameLayout>

    <TextView
        android:id="@+id/epCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/kzAccent"
        android:textStyle="bold"
        android:textSize="10sp"
        android:letterSpacing="0.05"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="6dp" />
    <TextView
        android:id="@+id/epTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textStyle="bold"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp" />
    <TextView
        android:id="@+id/epSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="3dp"
        android:paddingBottom="8dp" />
</LinearLayout>
