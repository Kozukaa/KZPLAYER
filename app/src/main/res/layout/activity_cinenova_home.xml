<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cnRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080B">

    <ImageView
        android:id="@+id/cnHeroBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.55" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#9905080B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cnSide"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="14dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp"
            android:background="#CC070A0F">

            <ImageView
                android:layout_width="116dp"
                android:layout_height="42dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:src="@drawable/kz_logo_wide"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/cnNavBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="18dp"
            android:paddingTop="72dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/cnHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="48sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#CC000000"
                android:shadowRadius="8" />

            <TextView
                android:id="@+id/cnHeroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/cnHeroDesc"
                android:layout_width="520dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cnRowsRv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="44dp"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
