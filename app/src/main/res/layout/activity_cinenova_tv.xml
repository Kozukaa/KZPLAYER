<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="#06101C" android:padding="14dp">
 <LinearLayout android:layout_width="285dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="16dp">
  <TextView android:id="@+id/titleTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textStyle="bold" android:textSize="20sp" android:layout_marginBottom="14dp" />
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/catRv" android:layout_width="match_parent" android:layout_height="match_parent" />
 </LinearLayout>
 <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="18dp">
  <TextView android:id="@+id/hintTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Maintenez OK sur une chaîne pour l'ajouter aux favoris" android:textColor="@color/muted" android:textSize="13sp" android:layout_marginBottom="12dp" />
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/itemRv" android:layout_width="match_parent" android:layout_height="match_parent" />
 </LinearLayout>
 <LinearLayout android:layout_width="430dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="10dp">
  <FrameLayout android:layout_width="match_parent" android:layout_height="210dp" android:background="@drawable/bg_cn_card_focus">
   <TextView android:id="@+id/previewTv" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Appuyez sur OK pour prévisualiser une chaîne" android:textColor="@color/muted" android:textSize="15sp" />
  </FrameLayout>
  <TextView android:id="@+id/channelTitleTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textStyle="bold" android:textSize="23sp" android:layout_marginTop="18dp" />
  <TextView android:id="@+id/channelMetaTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/kzAccent" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="6dp" />
  <TextView android:id="@+id/epgTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="22dp" android:lineSpacingExtra="4dp" />
 </LinearLayout>
</LinearLayout>
