<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nflx_hero" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_scrim_bottom" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="30dp"
                android:paddingBottom="30dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KZ PLAYER"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:letterSpacing="0.2" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ton univers TV, Films et Séries"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:layout_marginTop="6dp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">
                    <TextView
                        android:id="@+id/heroPlayTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶ Regarder la TV"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:background="@drawable/bg_nflx_play"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:clickable="true"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/heroMovies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Films"
                        android:textColor="@color/text"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:background="@drawable/bg_focus_chip"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_marginStart="14dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parcourir"
            android:textColor="@color/text"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="30dp"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileTv"
                    android:layout_width="150dp"
                    android:layout_height="112dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_tv"
                        android:tint="@color/text" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TV"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileMovies"
                    android:layout_width="150dp"
                    android:layout_height="112dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_movie"
                        android:tint="@color/text" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Films"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileSeries"
                    android:layout_width="150dp"
                    android:layout_height="112dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_series"
                        android:tint="@color/text" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Séries"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileGuide"
                    android:layout_width="150dp"
                    android:layout_height="112dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_epg"
                        android:tint="@color/text" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guide"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileVoice"
                    android:layout_width="150dp"
                    android:layout_height="112dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/text" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recherche"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileSettings"
                    android:layout_width="150dp"
                    android:layout_height="112dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/text" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paramètres"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileTheme"
                    android:layout_width="150dp"
                    android:layout_height="112dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_star"
                        android:tint="@color/text" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thème"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
