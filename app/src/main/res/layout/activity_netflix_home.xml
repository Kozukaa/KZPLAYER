<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barre de marque -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="42dp"
            android:paddingEnd="42dp"
            android:paddingTop="22dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KZ"
                android:textColor="?attr/kzAccent"
                android:textStyle="bold"
                android:textSize="30sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" PLAYER"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="30sp"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <!-- BANNIERE HERO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@drawable/bg_nflx_hero">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:paddingBottom="28dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vos cha\u00eenes, films et s\u00e9ries"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:textSize="34sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tout au m\u00eame endroit, en direct et \u00e0 la demande."
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp"
                    android:layout_marginTop="8dp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">
                    <TextView
                        android:id="@+id/nflxPlayTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\u25B6  Regarder la TV"
                        android:textColor="@color/text"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:background="@drawable/bg_nflx_play"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />
                    <TextView
                        android:id="@+id/nflxHeroMovies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Films / S\u00e9ries"
                        android:textColor="@color/text"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:background="@drawable/bg_focus_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="14dp"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- RANGEE 1 : Parcourir -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parcourir"
            android:textColor="@color/text"
            android:textStyle="bold"
            android:textSize="19sp"
            android:paddingStart="42dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="42dp"
            android:paddingEnd="42dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tileTv"
                    android:layout_width="248dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_live_tv"
                            android:tint="@color/text"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TV en direct"
                            android:textColor="@color/text"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tileGuide"
                    android:layout_width="248dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_epg"
                            android:tint="@color/text"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guide TV"
                            android:textColor="@color/text"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tileMovies"
                    android:layout_width="248dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_movie"
                            android:tint="@color/text"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Films"
                            android:textColor="@color/text"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tileSeries"
                    android:layout_width="248dp"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_series"
                            android:tint="@color/text"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S\u00e9ries"
                            android:textColor="@color/text"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- RANGEE 2 : Reglages & plus -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R\u00e9glages et plus"
            android:textColor="@color/text"
            android:textStyle="bold"
            android:textSize="19sp"
            android:paddingStart="42dp"
            android:paddingTop="22dp"
            android:paddingBottom="12dp" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="42dp"
            android:paddingEnd="42dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tileSettings"
                    android:layout_width="210dp"
                    android:layout_height="128dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/text"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R\u00e9glages"
                            android:textColor="@color/text"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginTop="9dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tileTheme"
                    android:layout_width="210dp"
                    android:layout_height="128dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_star"
                            android:tint="@color/text"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Th\u00e8me"
                            android:textColor="@color/text"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginTop="9dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tileUpdate"
                    android:layout_width="210dp"
                    android:layout_height="128dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_multiscreen"
                            android:tint="@color/text"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mise \u00e0 jour"
                            android:textColor="@color/text"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginTop="9dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tileVoice"
                    android:layout_width="210dp"
                    android:layout_height="128dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_mic"
                            android:tint="@color/text"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recherche vocale"
                            android:textColor="@color/text"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginTop="9dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="34dp" />
    </LinearLayout>
</ScrollView>
