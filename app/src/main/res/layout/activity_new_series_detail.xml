<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp">
        <ImageView
            android:id="@+id/heroImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim_hero" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim_bottom" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u2190 Retour"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:background="@drawable/bg_fav_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/seriesTitle"
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />
            <!-- Resume de la serie entiere : hauteur fixe + texte auto-ajuste,
                 il retrecit pour tenir en entier, donc visible d'un coup. -->
            <TextView
                android:id="@+id/heroDesc"
                android:layout_width="620dp"
                android:layout_height="78dp"
                android:textColor="#CCFFFFFF"
                android:layout_marginTop="8dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeStepGranularity="1sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <Button
                    android:id="@+id/playBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="\u25B6 Lecture"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_focus"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />
                <Button
                    android:id="@+id/favBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="\uFF0B Ma liste"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_ghost_btn"
                    android:layout_marginStart="10dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:padding="14dp">
        <LinearLayout
            android:id="@+id/seasonTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodeRv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
        <TextView
            android:id="@+id/msgTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/muted" />
    </FrameLayout>
</LinearLayout>
