<?xml version="1.0" encoding="utf-8"?>
<!-- v153 : Detail serie NewTivi - variante TELEPHONE. Hero 200dp au lieu de 280dp,
     largeurs titre/desc en match_parent au lieu de 560/620dp, boutons empiles verticalement.
     TV/tablette : layout-sw600dp/activity_new_series_detail.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/kzBg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">
        <ImageView
            android:id="@+id/heroImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim_hero" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim_bottom" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u2190 Retour"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:background="@drawable/bg_fav_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/seriesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/kzAccent"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />
            <TextView
                android:id="@+id/heroDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:layout_marginTop="5dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textSize="11sp"
                android:lineSpacingExtra="1dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/playBtn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="\u25B6 Lecture"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_focus" />
                <!-- v360 : vrai bouton de telechargement, a cote de Lecture -->
                <Button
                    android:id="@+id/downloadBtn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="\u2913 T\u00e9l\u00e9charger"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:background="@drawable/bg_action_btn"
                    android:stateListAnimator="@null"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginStart="8dp" />
                <TextView
                    android:id="@+id/favBtn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="\uFF0B Ma liste"
                    android:textSize="12sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_ghost_btn"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:padding="10dp">
        <LinearLayout
            android:id="@+id/seasonTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodeRv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="6dp"
            android:paddingEnd="32dp"
            android:clipToPadding="false" />
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
        <TextView
            android:id="@+id/msgTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/muted" />
    </FrameLayout>
</LinearLayout>
