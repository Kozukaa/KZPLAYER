<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="?attr/kzBg"
    android:padding="@dimen/cl_detail_pad">

    <!-- COLONNE GAUCHE : affiche + titre -->
    <LinearLayout
        android:layout_width="@dimen/cl_series_col_w"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginEnd="@dimen/cl_detail_pad">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2190 Retour"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:background="@drawable/bg_focus_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/posterIv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/cl_series_poster_maxh"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_tile"
            android:src="@drawable/ic_movie" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/seriesTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/favBtn"
                android:layout_width="32dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="\u2606"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:background="@drawable/bg_fav_chip"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saisons &amp; \u00e9pisodes"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/seriesSummary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:textColor="#CCFFFFFF"
            android:lineSpacingExtra="1dp"
            android:gravity="top"
            android:visibility="gone"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeStepGranularity="1sp" />

    </LinearLayout>

    <!-- COLONNE DROITE : liste des episodes sur toute la hauteur -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodeRv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/msgTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/muted"
            android:textSize="15sp" />
    </FrameLayout>

</LinearLayout>
