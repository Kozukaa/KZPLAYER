<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="40dp">
    <TextView
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2190 Retour"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingBottom="14dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Param\u00e8tres"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choisis une cat\u00e9gorie"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/themeMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_tile"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:layout_marginBottom="14dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\ud83c\udfa8  Th\u00e8me"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/themeStateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlistMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_tile"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\ud83d\udcfa  Liste de lecture"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/playlistStateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reloadMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_tile"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:layout_marginTop="14dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\ud83d\udd04  Recharger les listes"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/reloadStateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:text="Rafra\u00eechir la licence et les serveurs"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
