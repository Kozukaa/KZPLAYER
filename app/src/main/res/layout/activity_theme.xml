<?xml version="1.0" encoding="utf-8"?>
<!-- v153 : Ecran theme - variante TELEPHONE. Padding 20dp au lieu de 40dp, cards row
     180dp au lieu de 260dp, titre 22sp au lieu de 28sp, nom du theme 20sp au lieu de
     26sp. TV/tablette : layout-sw600dp/activity_theme.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/kzBg"
    android:padding="20dp">

    <TextView
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2190 Retour"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Th\u00e8me"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choisis ton th\u00e8me d'interface"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/themeClassic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="9dp"
            android:orientation="vertical"
            android:background="@drawable/bg_theme_classic"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TH\u00c8ME 1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:background="@drawable/bg_theme_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_live_tv"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="@null" />
            </LinearLayout>
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classique"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Interface historique"
                android:textColor="#DDFFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/classicState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF111111"
                android:textStyle="bold"
                android:textSize="9sp"
                android:background="@drawable/bg_theme_badge_current"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/themeNew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="9dp"
            android:orientation="vertical"
            android:background="@drawable/bg_theme_newtivi"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TH\u00c8ME 2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:background="@drawable/bg_theme_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_epg"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="@null" />
            </LinearLayout>
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NewTivi"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guide TV, menu lat\u00e9ral"
                android:textColor="#DDFFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/newState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF111111"
                android:textStyle="bold"
                android:textSize="9sp"
                android:background="@drawable/bg_theme_badge_current"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/themeNetflix"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_theme_netflix"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TH\u00c8ME 3"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:background="@drawable/bg_theme_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_movie"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="@null" />
            </LinearLayout>
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Netflix"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accueil cin\u00e9ma"
                android:textColor="#DDFFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/netflixState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF111111"
                android:textStyle="bold"
                android:textSize="9sp"
                android:background="@drawable/bg_theme_badge_current"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/themeCineNova"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_theme_netflix"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THÈME 4"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:background="@drawable/bg_theme_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_crown"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="@null" />
            </LinearLayout>
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CinéNova"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accueil premium, menu latéral"
                android:textColor="#DDFFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/cineNovaState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF111111"
                android:textStyle="bold"
                android:textSize="9sp"
                android:background="@drawable/bg_theme_badge_current"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
