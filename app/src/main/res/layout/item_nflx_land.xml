<?xml version="1.0" encoding="utf-8"?>
<!-- v153 : Netflix card landscape (Continuer / Fav) - variante TELEPHONE.
     Largeur 180dp (au lieu de 236dp), hauteur poster 100dp (au lieu de 134dp).
     TV/tablette : layout-sw600dp/item_nflx_land.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_nflx_card"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/posterIv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tile"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_nflx_poster_scrim" />

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="5dp"
                android:background="#44FFFFFF" />
            <View
                android:layout_width="68dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="5dp"
                android:background="?attr/kzAccent" />

            <TextView
                android:id="@+id/nameTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </FrameLayout>

        <TextView
            android:id="@+id/subTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
