<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ntSidebar"
    android:layout_width="@dimen/nt_sidebar_w"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/kzBg2"
    android:paddingStart="@dimen/nt_sidebar_pad"
    android:paddingEnd="@dimen/nt_sidebar_pad"
    android:clipToPadding="false"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/logoIv"
        android:layout_width="@dimen/nt_logo_size"
        android:layout_height="@dimen/nt_logo_size"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/nt_logo_margin_v"
        android:layout_marginBottom="@dimen/nt_logo_margin_v"
        android:src="@drawable/kz_logo_icon"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:adjustViewBounds="true"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/navTv"
        android:nextFocusDown="@id/navMovies"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nt_nav_item_h"
        android:layout_marginBottom="@dimen/nt_nav_item_margin"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_nav_item">
        <ImageView
            android:id="@+id/navTvImg"
            android:layout_width="@dimen/nt_nav_icon"
            android:layout_height="@dimen/nt_nav_icon"
            android:src="@drawable/ic_live_tv"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/navTvLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navMovies"
        android:nextFocusUp="@id/navTv"
        android:nextFocusDown="@id/navSeries"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nt_nav_item_h"
        android:layout_marginBottom="@dimen/nt_nav_item_margin"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_nav_item">
        <ImageView
            android:id="@+id/navMoviesImg"
            android:layout_width="@dimen/nt_nav_icon"
            android:layout_height="@dimen/nt_nav_icon"
            android:src="@drawable/ic_movie"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/navMoviesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Films"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSeries"
        android:nextFocusUp="@id/navMovies"
        android:nextFocusDown="@id/navGuide"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nt_nav_item_h"
        android:layout_marginBottom="@dimen/nt_nav_item_margin"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_nav_item">
        <ImageView
            android:id="@+id/navSeriesImg"
            android:layout_width="@dimen/nt_nav_icon"
            android:layout_height="@dimen/nt_nav_icon"
            android:src="@drawable/ic_tv"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/navSeriesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S\u00e9ries"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navGuide"
        android:nextFocusUp="@id/navSeries"
        android:nextFocusDown="@id/navSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nt_nav_item_h"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_nav_item">
        <ImageView
            android:id="@+id/navGuideImg"
            android:layout_width="@dimen/nt_nav_icon"
            android:layout_height="@dimen/nt_nav_icon"
            android:src="@drawable/ic_epg"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/navGuideLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guide"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/navSearch"
        android:nextFocusUp="@id/navGuide"
        android:nextFocusDown="@id/navSettings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nt_nav_item_h"
        android:layout_marginBottom="@dimen/nt_nav_item_margin"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_nav_item">
        <ImageView
            android:id="@+id/navSearchImg"
            android:layout_width="@dimen/nt_nav_icon"
            android:layout_height="@dimen/nt_nav_icon"
            android:src="@drawable/ic_search"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/navSearchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recherche"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="18dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSettings"
        android:nextFocusUp="@id/navSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nt_nav_item_h"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_nav_item">
        <ImageView
            android:id="@+id/navSettingsImg"
            android:layout_width="@dimen/nt_nav_icon"
            android:layout_height="@dimen/nt_nav_icon"
            android:src="@drawable/ic_settings"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/navSettingsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R\u00e9glages"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
