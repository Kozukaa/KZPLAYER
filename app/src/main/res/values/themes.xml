        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="listChoiceBackgroundIndicator">@drawable/bg_dialog_item</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_dialog_item</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/card</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

